#!/usr/bin/env bash
# git pre-commit: єдиний quality gate проєкту - black, flake8, тести.
#
# Навіщо git-хук, а не PostToolUse: PostToolUse на тести спрацював би після
# КОЖНОГО Edit. Десять правок у межах одного плану - десять прогонів на
# проміжному стані, дев'ять з яких червоні по дорозі, і весь цей шум іде в
# контекст. Claude кидає план і лізе в micro-fix loop лагодити те, що і так
# мало полагодитись наступною правкою. Pre-commit дає рівно один сигнал на
# фінальному стані: один фідбек - одна реакція - один коміт.
#
# Асиметрія, на якій це тримається: людині 30-180 секунд очікування на коміті
# болять, і вона шукає --no-verify. Агенту байдуже - він не втомлюється і не
# сперечається. Той самий гейт, який люди вимикають, для агента працює.
#
# Лежить у .githooks/, а не в .git/hooks/, бо .git/hooks не трекається git:
# гейт має версіонуватись разом із кодом, який стереже.
# Вмикається один раз: git config core.hooksPath .githooks
set -uo pipefail

PY=.venv/bin/python
BLACK=.venv/bin/black
FLAKE8=.venv/bin/flake8

red() { printf '\033[31m%s\033[0m\n' "$1" >&2; }
green() { printf '\033[32m%s\033[0m\n' "$1"; }
yellow() { printf '\033[33m%s\033[0m\n' "$1" >&2; }

fail() {
  red "PRE-COMMIT FAILED: $1"
  [ -n "${2:-}" ] && red "  -> $2"
  exit 1
}

if [ ! -x "$PY" ]; then
  fail ".venv не знайдено" "створи оточення або зніми core.hooksPath"
fi

# Тільки .py, які реально йдуть у коміт. Фільтр ACMR відкидає видалені файли -
# інакше black спіткнеться об шлях, якого вже немає на диску.
# Читаємо циклом, а не через mapfile: mapfile з'явився у bash 4, а стоковий
# macOS досі везе /bin/bash 3.2 - гейт має працювати і там.
staged=()
while IFS= read -r path; do
  [ -n "$path" ] && staged+=("$path")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.py')

# --- 1. Формат ------------------------------------------------------------
# Перевіряємо ЛИШЕ staged-файли: black --check по всьому репо звинуватив би
# коміт у чужому форматуванні, до якого автор не дотикався.
if [ ${#staged[@]} -gt 0 ]; then
  if ! "$BLACK" --check --quiet "${staged[@]}" 2>/dev/null; then
    "$BLACK" --check --diff "${staged[@]}" 2>&1 | head -40 >&2
    fail "black: staged-файли не відформатовані" "black . && git add -u"
  fi
  green "black: ok (${#staged[@]} файл(ів))"
else
  green "black: пропущено, .py у staged немає"
fi

# --- 2. Лінтер ------------------------------------------------------------
# Тут навпаки - по всьому репо. CLAUDE.md фіксує baseline "zero findings",
# тож будь-який вивід означає регресію, навіть у файлі поза staged: імпорт,
# що зламався від перейменування в іншому місці, інакше просочиться.
flake8_out=$("$FLAKE8" 2>&1)
if [ -n "$flake8_out" ]; then
  printf '%s\n' "$flake8_out" | head -30 >&2
  fail "flake8: $(printf '%s\n' "$flake8_out" | wc -l | tr -d ' ') знахідок" \
    "baseline цього репо - нуль"
fi
green "flake8: чисто"

# --- 3. Тести -------------------------------------------------------------
# Проба з'єднання окремо від тестів: інакше "БД не піднята" і "тест упав"
# віддають однаковий ненульовий код, і гейт блокує коміт за відсутню
# інфраструктуру.
#
# Чому НЕ локальний інтерпретатор, як було до 2026-08-25: .env описує
# docker-мережу (POSTGRES_HOST - ім'я compose-сервісу), тож із хоста воно не
# резолвиться; а під пісочницею .env ще й закритий на читання, і load_dotenv
# у такому разі мовчить, лишаючи SECRET_KEY порожнім. Обидва провали виглядали
# однаково - "Postgres недоступний" - тому тестова частина не запускалась
# ЖОДНОГО разу, а порада підняти базу не могла зарадити. Основний шлях тепер
# той самий контейнер, де живе застосунок; локальний лишається запасним.

compose_cmd() {
  if docker compose version >/dev/null 2>&1; then
    printf 'docker compose'
  elif docker-compose version >/dev/null 2>&1; then
    printf 'docker-compose'
  fi
}

# Сервіс шукаємо серед ЗАПУЩЕНИХ і за наявністю manage.py, а не за іменем:
# ім'я django-сервісу в цьому compose - evaluation_form, у гілках буває інше,
# а manage.py у WORKDIR - ознака надійна.
find_runner() {
  local compose svc
  compose=$(compose_cmd)
  [ -z "$compose" ] && return 1
  for svc in $($compose ps --services 2>/dev/null); do
    if $compose exec -T "$svc" test -f manage.py >/dev/null 2>&1; then
      printf '%s exec -T %s python' "$compose" "$svc"
      return 0
    fi
  done
  return 1
}

RUNNER=$(find_runner) || RUNNER="$PY"

# timeout не входить у стоковий macOS - він приїжджає з coreutils (як timeout
# або gtimeout). Без цієї перевірки проба падала б із "command not found", і
# гейт зарахував би це за недоступну базу: та сама підміна причини, яку цей
# блок і лагодить. Немає жодного - працюємо без ліміту, проба сама коротка.
TIMEOUT=""
if command -v timeout >/dev/null 2>&1; then
  TIMEOUT="timeout 30"
elif command -v gtimeout >/dev/null 2>&1; then
  TIMEOUT="gtimeout 30"
fi

# Вивід проби зберігаємо, а не глушимо в /dev/null: саме через це гейт роками
# вгадував причину замість того, щоб її показати.
probe_err=$($TIMEOUT $RUNNER manage.py shell \
  -c 'from django.db import connection; connection.ensure_connection()' 2>&1)
probe_rc=$?

if [ $probe_rc -eq 0 ]; then
  # Без конвеєра: `cmd | tail` віддає код tail, тобто нуль навіть на червоних
  # тестах. Стара гілка мала цю пастку і не впала б на жодному падінні.
  test_out=$($RUNNER manage.py test --verbosity=1 2>&1)
  test_rc=$?
  printf '%s\n' "$test_out" | tail -25
  if [ $test_rc -ne 0 ]; then
    fail "тести червоні" "полагодь або зніми зміни зі staged"
  fi
  green "тести: ok (раннер: $RUNNER)"
else
  yellow "тести: ПРОПУЩЕНО - Django не достукався до бази"
  printf '%s\n' "$probe_err" | tail -3 >&2
  yellow "  раннер: $RUNNER"
  yellow "  підняти: docker-compose up -d (потрібен і сервіс застосунку, не лише db)"
  yellow "  lint-частина гейта відпрацювала; тести проженіть перед push"
fi

green "PRE-COMMIT PASSED"
exit 0
